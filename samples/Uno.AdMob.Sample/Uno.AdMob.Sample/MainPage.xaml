<Page x:Class="Uno.AdMob.Sample.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:admob="using:Uno.AdMob"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid RowDefinitions="*,Auto">
    <StackPanel Padding="16"
                Spacing="8"
                VerticalAlignment="Center">
      <TextBlock x:Name="SupportedText"
                 AutomationProperties.AutomationId="SupportedText" />
      <TextBlock x:Name="EventText"
                 AutomationProperties.AutomationId="EventText"
                 Text="Last banner event: (none)" />
    </StackPanel>
    <admob:BannerAd x:Name="Banner"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch" />
  </Grid>
</Page>
