<Project Sdk="Uno.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041;net10.0</TargetFrameworks>
		<RootNamespace>Uno.AdMob</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>Martin Zikmund</Authors>
		<IsPackable>true</IsPackable>
		<PackageId>MZikmund.Uno.AdMob</PackageId>
		<Description>Google AdMob ads for Uno Platform on Android and iOS – banner, interstitial, rewarded, rewarded interstitial and app open ads plus GDPR consent (UMP). Port of Plugin.AdMob.</Description>
		<RepositoryUrl>https://github.com/MartinZikmund/Uno.AdMob</RepositoryUrl>
		<PackageProjectUrl>https://github.com/MartinZikmund/Uno.AdMob</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageTags>admob;google-mobile-ads;ads;monetization;banner;interstitial;rewarded;app-open;consent;ump;gdpr;uno;uno-platform;android;ios</PackageTags>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>embedded</DebugType>
		<!-- Version comes from Nerdbank.GitVersioning (src/version.json). Do not hardcode it here. -->
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Uno.AdMob.Tests" />
	</ItemGroup>

	<!-- Upstream files are not fully documented / use events only some platforms raise -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
		<NoWarn>$(NoWarn);CS1591;CS0067</NoWarn>
	</PropertyGroup>

	<!-- Shared dependencies -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>

	<!-- Android dependencies -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Google.Android.Libraries.Ads.Mobile.Sdk" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
	</ItemGroup>

	<!-- iOS dependencies -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="Jc.GMA.iOS" />
		<PackageReference Include="Jc.UMP.iOS" />
	</ItemGroup>

	<!-- Platform code filtering -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
		<Compile Remove="Platforms\Android\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
		<Compile Remove="Platforms\iOS\**\*.cs" />
	</ItemGroup>

	<!-- Package content -->
	<ItemGroup>
		<None Include="buildTransitive\**" Pack="True" PackagePath="buildTransitive" Condition="Exists('buildTransitive')" />
		<None Include="..\..\README.md" Pack="True" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="True" PackagePath="\" />
		<None Include="..\..\.nuget\icon.png" Pack="True" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
